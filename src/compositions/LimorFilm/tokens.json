{
  "canvas": { "width": 1920, "height": 1080, "fps": 30, "durationInFrames": 3150 },

  "palette": {
    "mineral": "#0B0A09",
    "mineralWarm": "#131110",
    "limestone": "#1C1917",
    "bone": "#EDE6D9",
    "sand": "#BFB09A",
    "clay": "#7D6E5A",
    "ash": "#4A423A",
    "amber": "#D69A52",
    "amberDim": "#8A6435",
    "blue": "#35566E",
    "blueDim": "#22384A"
  },

  "type": {
    "family": "Inter",
    "weights": [300, 400, 500],
    "scale": {
      "hero": 132,
      "statement": 92,
      "question": 78,
      "line": 54,
      "word": 40,
      "fragment": 27,
      "whisper": 21
    },
    "tracking": {
      "hero": -0.045,
      "statement": -0.035,
      "line": -0.02,
      "word": 0.02,
      "fragment": 0.06
    },
    "leading": 1.18
  },

  "motion": {
    "comment": "No overshoot anywhere. Nothing scales past 1.02. Everything is opacity plus a short vertical settle.",
    "ease": "cubic-bezier(0.22, 0.61, 0.36, 1)",
    "easeOut": "cubic-bezier(0.33, 1, 0.68, 1)",
    "riseDistance": 14,
    "fadeInFrames": 26,
    "fadeOutFrames": 20,
    "settleFrames": 44,
    "staggerFrames": 7
  },

  "grain": {
    "opacity": 0.055,
    "comment": "Film grain over everything. Keeps the mineral surface from reading as flat digital black."
  },

  "network": {
    "comment": "Knowledge particles. Points that drift, then remember each other. Connections are curved beziers that GROW along their length - roots and leaf veins, never straight circuit traces.",
    "particleRadius": [1.4, 3.2],
    "linkWidth": [0.5, 1.5],
    "linkCurvature": 0.34,
    "growthFrames": 38,
    "maxLinkDistance": 300,
    "driftAmplitude": 9,
    "driftPeriodFrames": 220
  },

  "forbidden": [
    "avatar", "presenter", "person", "robot", "brain-anatomy", "glowing-orb",
    "circuit-board", "hologram", "floating-code", "neon", "purple",
    "lightbulb", "puzzle-piece", "rocket", "dashboard-mockup"
  ]
}
